# Credentials & auth
.credentials.json
mcp-needs-auth-cache.json

# Conversation history & sessions
history.jsonl
sessions/
sessions-index.json

# Ephemeral / machine-specific
cache/
debug/
telemetry/
statsig/
stats-cache.json
file-history/
paste-cache/
shell-snapshots/
backups/
tasks/
todos/
ide/
plugins/

# Project data (session logs, plans, memory)
# All behavioral rules are now in CLAUDE.md (always loaded)
projects/
settings.local.json
image-cache/

# Ticket artifacts: ignore the bulky dumps, keep the small human-authored evidence
# (contents-level ignore so the un-ignores below can re-include — git cannot re-include
# inside an ignored directory)
tickets/**/artifacts/**
!tickets/**/artifacts/db-queries/
!tickets/**/artifacts/db-queries/**
!tickets/**/artifacts/pr/
!tickets/**/artifacts/pr/**

# Python bytecode
__pycache__/
*.pyc

# Claude machine/remote-managed state (re-synced locally; don't track)
.last-*
remote-settings.json
policy-limits.json

# Daemon runtime state (locks, logs, keys, PIDs, roster, auth). All of it is machine-local.
daemon*

# Local caches
gh-pr-status-cache.json
jobs/
.post-approval-state.json
